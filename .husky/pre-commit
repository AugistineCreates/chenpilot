STAGED_ENV_FILES=$(git diff --cached --name-only --diff-filter=A | grep -E '^\.env\.' | grep -v '\.env\.example$' || true)
if [ -n "$STAGED_ENV_FILES" ]; then
  echo "ERROR: Attempting to commit .env files:"
  echo "$STAGED_ENV_FILES"
  echo "Commit .env.example with placeholder values only."
  echo "Use --no-verify to override (not recommended)."
  exit 1
fi

# Use an explicit config file so lint-staged does not walk node_modules and
# pick up stale legacy "lint-staged" configs shipped inside vendored packages.
node node_modules/lint-staged/bin/lint-staged.js --config .lintstagedrc
