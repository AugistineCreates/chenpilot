#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run supply chain security verification before push
echo "🔒 Running supply chain security checks..."

if command -v pwsh &> /dev/null; then
    pwsh -File scripts/verify-supply-chain.ps1
elif command -v bash &> /dev/null; then
    bash scripts/verify-supply-chain.sh
else
    echo "⚠️  Warning: Could not find PowerShell or Bash to run verification"
    exit 0
fi

if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Supply chain security verification failed!"
    echo "   Please fix the issues above before pushing."
    echo "   See SUPPLY_CHAIN_SECURITY.md for guidance."
    exit 1
fi

echo "✅ Supply chain security checks passed"
