# ============================================================================
# Supply Chain Security Configuration
# ============================================================================
# This file prevents dependency confusion attacks and unreviewed lifecycle scripts
# Last updated: 2026-08-31

# ----------------------------------------------------------------------------
# Registry Configuration - Prevent Dependency Confusion
# ----------------------------------------------------------------------------
# All internal @chen-pilot packages MUST resolve from internal registry only
# This prevents attackers from publishing malicious packages with same names to public npm
@chen-pilot:registry=https://npm.pkg.github.com/chen-pilot

# Default registry for all other packages
registry=https://registry.npmjs.org/

# ----------------------------------------------------------------------------
# Lifecycle Script Protection
# ----------------------------------------------------------------------------
# Disable all install scripts by default to prevent arbitrary code execution
# Only explicitly allowed packages can run install scripts
ignore-scripts=true

# ----------------------------------------------------------------------------
# Integrity and Lock Enforcement
# ----------------------------------------------------------------------------
# Enforce package-lock.json integrity checks
package-lock=true
package-lock-only=false

# Fail installation if package-lock.json is out of sync
ci=false

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------
# Audit level - fail on moderate and above vulnerabilities
audit-level=moderate

# Automatically fix vulnerabilities when possible
audit=true

# ----------------------------------------------------------------------------
# Network Security
# ----------------------------------------------------------------------------
# Use HTTPS for git dependencies
git-protocol=https

# Strict SSL verification
strict-ssl=true

# Network timeout to prevent hanging builds
fetch-timeout=60000
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# ----------------------------------------------------------------------------
# Package Provenance
# ----------------------------------------------------------------------------
# Verify package signatures when available
verify-signatures=true

# ----------------------------------------------------------------------------
# Workspace Configuration
# ----------------------------------------------------------------------------
# Enable workspace support
workspaces=true
workspace-root=true

# ----------------------------------------------------------------------------
# Build Configuration
# ----------------------------------------------------------------------------
# Prevent optional dependencies from failing the build
optional=false

# Save exact versions (not ranges) for security
save-exact=true

# Engine strict mode - enforce Node version compatibility
engine-strict=true
